# Must => all condition should match
# Example, the total values is 15 where both condition matched

GET alerts/_search
{
  "query": {
    "bool": {
      "must": [
        {
          "term": {
            "airline.keyword": "IndiGo"
          }
        },
        {
          "term": {
            "status": "DELAYED"
          }
        }
      ]
    }
  }
}


